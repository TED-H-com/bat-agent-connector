{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Agent Dashboard",
  "version": "0.1.3",
  "identifier": "io.betteragent.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Better Agent Dashboard", "width": 1180, "height": 800,
      "minWidth": 390, "minHeight": 480, "create": false }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": ["dashboard"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "shortDescription": "Desktop client for the existing BAT Agent Connector",
    "resources": {
      "../managed-runtime/": "managed-runtime/",
      "../vendor/glib-0.18.5/LICENSE": "third-party/glib/LICENSE",
      "../vendor/glib-0.18.5/COPYRIGHT": "third-party/glib/COPYRIGHT"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {"updater": {"pubkey": "", "requireSignedVersion": true, "windows": {"installMode": "passive"}}}
}
