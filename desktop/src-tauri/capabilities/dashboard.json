{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard",
  "description": "Only the packaged main Dashboard may use the constrained central transport.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-managed-control",
    "allow-desktop-update",
    "allow-native-status",
    "allow-connector-connect",
    "allow-connector-disconnect",
    "allow-connector-reload-configuration",
    "allow-connector-setup-configuration",
    "allow-connector-forget-credential",
    "allow-connector-enroll",
    "allow-connector-request",
    "allow-open-external",
    "allow-fleet-availability",
    "allow-fleet-request",
    "allow-fleet-control",
    "allow-fleet-bootstrap",
    "allow-tailscale-control",
    "allow-native-files-status",
    "allow-native-files-pick",
    "allow-native-files-drop-target",
    "allow-native-files-upload",
    "allow-native-files-save",
    "allow-native-brief-save",
    "allow-native-diagnostics-save",
    "allow-native-files-control",
    "allow-native-files-preview"
  ]
}
