{
  "name": "better-agent-dashboard",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:browser": "tsc --noEmit && vite build --mode browser && node scripts/browser-assets.mjs",
    "build:prototype": "vite build --config prototype/v1.3/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:all": "npm run build && npm run build:browser",
    "check:browser": "node scripts/check-browser-assets.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:delivery": "node tests/delivery-integration.mjs",
    "test:central": "node tests/central-integration.mjs",
    "test:attention": "node tests/attention-integration.mjs",
    "tauri": "tauri",
    "test:cleanup": "node tests/cleanup-integration.mjs",
    "test:task-cleanup": "node tests/task-cleanup-integration.mjs",
    "test:artifacts": "node tests/artifact-integration.mjs",
    "test:observation": "node tests/observation-integration.mjs",
    "test:capture": "node tests/capture-integration.mjs",
    "test:task-controls": "node tests/task-controls-integration.mjs",
    "test:permissions": "node tests/permissions-integration.mjs",
    "test:approvals": "node tests/approvals-integration.mjs",
    "test:native-files": "node tests/native-files-integration.mjs",
    "test:published": "node tests/repository-start-integration.mjs",
    "test:dispatch": "node tests/project-dispatch-integration.mjs",
    "test:pm": "node tests/pm-central-integration.mjs",
    "test:walkthrough": "node tests/pm-walkthrough.mjs",
    "test:start": "node tests/session-start-integration.mjs",
    "test:artifact-review": "node tests/artifact-review-integration.mjs",
    "test:orchestration": "node tests/orchestration-integration.mjs",
    "test:labels": "node tests/session-labels-integration.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "acorn": "8.15.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
